# Copy to .env and fill in:  cp .env.example .env && nano .env && chmod 600 .env
# Keep .env out of git: it holds your API key and database password.

# aisstream.io key (sign in with GitHub at aisstream.io, then create a key)
AISSTREAM_API_KEY=your-api-key-here

# Database connection (standard PostgreSQL variables)
PGHOST=localhost
PGPORT=5432
PGDATABASE=ais
PGUSER=ais
PGPASSWORD=your-database-password

# Area to collect: lat_min,lon_min,lat_max,lon_max (several boxes separated by ;)
# Default is the Caribbean basin: the Florida peninsula and Keys, the Bahamas,
# Cuba, Jamaica, Hispaniola, Puerto Rico, the Lesser Antilles out to Barbados
# and Trinidad, and the Caribbean coast of Colombia and Venezuela.
AIS_BBOXES=10,-83,31,-59

# Optional: only these message types (comma separated). Empty = everything.
AIS_MESSAGE_TYPES=

# Force a reconnect if no messages arrive for this many seconds.
STALE_SECONDS=300

# Status display (display/README.md): which disk's free space to show.
# Change to the SSD's mount point if you move the database there.
DISPLAY_DISK_PATH=/
